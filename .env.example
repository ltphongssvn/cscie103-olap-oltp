# .env.example
# GENERATED FROM src/cscie103_olap_oltp/environment.py -- DO NOT EDIT.
# Regenerate with `mise run env:template`.
#
# Copy to .env and fill in the required values. .env is gitignored;
# this file is the committed contract and carries no real values.

# Set by the runner. Decides whether missing credentials fail or skip.
# required: no
CI=true

# Workspace URL. CI only -- setting it locally overrides profile auth.
# required: no
DATABRICKS_HOST=https://dbc-00000000-0000.cloud.databricks.com

# Forces one auth method when several are present. CI sets oauth-m2m.
# required: no
DATABRICKS_AUTH_TYPE=oauth-m2m

# SSH host alias of the Lightning Studio. Per-person.
# required: yes
LIGHTNING_STUDIO=your-studio-name

# owner/teamspace. The CLI cannot resolve it unaided.
# required: yes
LIGHTNING_TEAMSPACE=owner/teamspace

# Service principal application id. NOT secret -- it is a username.
# required: no
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# OAuth M2M secret. NEVER commit. CI supplies it from the secret store.
# required: no
DATABRICKS_CLIENT_SECRET=

# Path to the ssh-agent socket. Absent means no agent is reachable.
# required: no
SSH_AUTH_SOCK=/private/tmp/com.apple.launchd.ABC/Listeners

# Read by gh on a runner; a keyring supplies it on a laptop.
# required: no
GH_TOKEN=
