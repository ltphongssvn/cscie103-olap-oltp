{
  "description": "Third-normal-form entities. Generated from src/cscie103_olap_oltp/oltp/contracts.py -- edit those models, then run `mise run oltp:contracts`.",
  "tables": {
    "category": {
      "api": "pandas",
      "coerce": true,
      "columns": {
        "category_id": {
          "dtype": "int64",
          "greater_than": 0,
          "unique": true
        },
        "category_name": {
          "dtype": "string[python]"
        }
      },
      "description": "A product's category, SEPARATED TO REMOVE A TRANSITIVE DEPENDENCY.\n\n    Held on `product` instead, renaming a category would mean updating every\n    product row -- and a partial update leaves two names for one category.\n    ",
      "name": "Category",
      "schema_type": "dataframe",
      "strict": true
    },
    "customer": {
      "api": "pandas",
      "coerce": true,
      "columns": {
        "customer_id": {
          "dtype": "int64",
          "greater_than": 0,
          "unique": true
        },
        "email_domain": {
          "dtype": "string[python]"
        },
        "full_name": {
          "dtype": "string[python]"
        },
        "registered_at": {
          "dtype": "datetime64[ns]"
        }
      },
      "description": "Who placed an order. One row per customer.",
      "name": "Customer",
      "schema_type": "dataframe",
      "strict": true
    },
    "order": {
      "api": "pandas",
      "coerce": true,
      "columns": {
        "customer_id": {
          "dtype": "int64",
          "greater_than": 0
        },
        "order_id": {
          "dtype": "int64",
          "greater_than": 0,
          "unique": true
        },
        "ordered_at": {
          "dtype": "datetime64[ns]"
        },
        "status": {
          "dtype": "string[python]",
          "isin": [
            "placed",
            "shipped",
            "delivered",
            "cancelled"
          ]
        }
      },
      "description": "A placed order. One row per order.",
      "name": "Order",
      "schema_type": "dataframe",
      "strict": true
    },
    "order_line": {
      "api": "pandas",
      "coerce": true,
      "columns": {
        "line_number": {
          "dtype": "int64",
          "greater_than": 0
        },
        "order_id": {
          "dtype": "int64",
          "greater_than": 0
        },
        "product_id": {
          "dtype": "int64",
          "greater_than": 0
        },
        "quantity": {
          "dtype": "int64",
          "greater_than": 0
        },
        "unit_price": {
          "dtype": "float64",
          "greater_than": 0
        }
      },
      "description": "One line of an order. THE GRAIN IS (order_id, line_number).\n\n    order_id ALONE IS NOT UNIQUE HERE, by design -- an order has many lines.\n    Asserting the composite key is what stops a later fact table from\n    double-counting revenue, which is the classic failure when a fact is built\n    at a grain nobody stated.\n    ",
      "name": "OrderLine",
      "schema_type": "dataframe",
      "strict": true,
      "unique": [
        "order_id",
        "line_number"
      ]
    },
    "product": {
      "api": "pandas",
      "coerce": true,
      "columns": {
        "category_id": {
          "dtype": "int64",
          "greater_than": 0
        },
        "list_price": {
          "dtype": "float64",
          "greater_than": 0
        },
        "product_id": {
          "dtype": "int64",
          "greater_than": 0,
          "unique": true
        },
        "product_name": {
          "dtype": "string[python]"
        }
      },
      "description": "What was sold. One row per product.",
      "name": "Product",
      "schema_type": "dataframe",
      "strict": true
    }
  },
  "title": "OLTP contracts"
}
